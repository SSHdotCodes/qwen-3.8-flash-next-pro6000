+    # SGLang ships its own SM120 FA4 dispatcher in this same image; route the
+    # fallback through that implementation on RTX Blackwell.
+    from sglang.srt.utils.common import is_sm120_supported
+
+    if is_sm120_supported():
+        from sglang.kernels.ops.attention.flash_attention_v4 import (
+            flash_attn_varlen_func as sglang_fa4_varlen_func,
+        )
+
+        return sglang_fa4_varlen_func
+
